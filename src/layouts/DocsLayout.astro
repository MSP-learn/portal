---
// @ts-nocheck
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/base-path';

const { title, description, sidebar = [], toc = [], repoUrl, currentPath = '/', updatedAt = null, issues = [], kind = 'portal', sourceId = '', repo = '', slug = '' } = Astro.props;

// Format the ISO date for display
const formattedDate = updatedAt ? new Date(updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

// Build the GitHub issue URL for raising a new question
const raiseIssueUrl = kind === 'source' && repo
  ? `https://github.com/${repo}/issues/new?title=Question%20about%3A%20${encodeURIComponent(slug)}&labels=page:${encodeURIComponent(sourceId)}/${encodeURIComponent(slug)}`
  : null;
const base = import.meta.env.BASE_URL;
const hrefFor = (href) => withBase(base, href);
---
<BaseLayout title={title} description={description} repoUrl={repoUrl} docsNavToggle={sidebar.length > 0}>
  <div class="page docs-page" data-docs-shell data-sidebar-open="false">
    {sidebar.length ? (
      <>
        <details class="docs-nav-fallback">
          <summary>Browse docs</summary>
          <nav class="sidebar sidebar--fallback" aria-label="Documentation navigation fallback">
            {sidebar.map((section) => (
              <section class="sidebar__section">
                <div class="sidebar__label">{section.label}</div>
                <div class="sidebar__links">
                  {section.items.map((item) => item.children?.length ? (
                    <details open={currentPath.startsWith(item.href)}>
                      <summary>{item.label}</summary>
                      <div class="sidebar__children">
                        <a href={hrefFor(item.href)} class={currentPath === item.href ? 'active' : undefined}>Overview</a>
                        {item.children.map((child) => child.children?.length ? (
                          <details class="sidebar__subsection" open={currentPath.startsWith(child.href || child.children[0]?.href)}>
                            <summary>{child.label}</summary>
                            <div class="sidebar__children">
                              {child.children.map((sub) => (
                                <a href={hrefFor(sub.href)} class={currentPath === sub.href ? 'active' : undefined}>{sub.label}</a>
                              ))}
                            </div>
                          </details>
                        ) : (
                          <a href={hrefFor(child.href)} class={currentPath === child.href ? 'active' : undefined}>{child.label}</a>
                        ))}
                      </div>
                    </details>
                  ) : (
                    <a href={hrefFor(item.href)} class={currentPath === item.href ? 'active' : undefined}>{item.label}</a>
                  ))}
                </div>
              </section>
            ))}
          </nav>
        </details>
        <button type="button" class="docs-nav__backdrop" data-docs-nav-close aria-label="Close documentation navigation" hidden disabled></button>
        <aside class="docs-nav" data-docs-nav-shell>
          <nav id="docs-sidebar" class="sidebar" aria-label="Documentation navigation">
            {sidebar.map((section) => (
              <section class="sidebar__section">
                <div class="sidebar__label">{section.label}</div>
                <div class="sidebar__links">
                  {section.items.map((item) => item.children?.length ? (
                    <details open={currentPath.startsWith(item.href)}>
                      <summary>{item.label}</summary>
                      <div class="sidebar__children">
                        <a href={hrefFor(item.href)} class={currentPath === item.href ? 'active' : undefined}>Overview</a>
                        {item.children.map((child) => child.children?.length ? (
                          <details class="sidebar__subsection" open={currentPath.startsWith(child.href || child.children[0]?.href)}>
                            <summary>{child.label}</summary>
                            <div class="sidebar__children">
                              {child.children.map((sub) => (
                                <a href={hrefFor(sub.href)} class={currentPath === sub.href ? 'active' : undefined}>{sub.label}</a>
                              ))}
                            </div>
                          </details>
                        ) : (
                          <a href={hrefFor(child.href)} class={currentPath === child.href ? 'active' : undefined}>{child.label}</a>
                        ))}
                      </div>
                    </details>
                  ) : (
                    <a href={hrefFor(item.href)} class={currentPath === item.href ? 'active' : undefined}>{item.label}</a>
                  ))}
                </div>
              </section>
            ))}
          </nav>
        </aside>
      </>
    ) : null}

    <main class="content docs-content">
      <slot />
      {
        kind === 'source' && (
          <section class="qa-section">
            {formattedDate && (
              <p class="qa-section__updated">Last updated: {formattedDate}</p>
            )}
            <h2 class="qa-section__heading">Questions</h2>
            {raiseIssueUrl && (
              <a href={raiseIssueUrl} target="_blank" rel="noopener noreferrer" class="button button--question">
                Raise a question <span aria-hidden="true">↗</span>
              </a>
            )}
            {issues.length > 0 && (
              <ul class="qa-section__list">
                {issues.map((issue) => (
                  <li class="qa-section__item">
                    <span class={`qa-section__status-dot qa-section__status-dot--${issue.state}`} title={issue.state === 'open' ? 'Open' : 'Closed'}></span>
                    <a href={issue.htmlUrl} target="_blank" rel="noopener noreferrer" class="qa-section__issue-link">
                      <span class="qa-section__issue-title">{issue.title}</span>
                      <span class="qa-section__issue-meta">#{issue.number}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {issues.length === 0 && (
              <p class="muted">No questions yet. Be the first to ask!</p>
            )}
          </section>
        )
      }
      <footer class="footer">MSP keeps documentation with its source repository and publishes one searchable library.</footer>
    </main>

    <aside class="toc" aria-label="Table of contents">
      <section class="toc__section">
        <div class="toc__label">On this page</div>
        <div class="toc__links">
          {toc.length ? toc.map((item) => (
            <a href={`#${item.slug}`}>{item.text}</a>
          )) : <p class="muted">No headings yet.</p>}
        </div>
      </section>
    </aside>
  </div>

  <script is:inline>
    const docsShell = document.querySelector('[data-docs-shell]');
    const docsNav = docsShell?.querySelector('#docs-sidebar');
    const docsNavClose = docsShell?.querySelector('[data-docs-nav-close]');
    const docsNavToggles = document.querySelectorAll('[data-docs-nav-toggle]');
    const topbar = document.querySelector('.topbar');
    const mobileDocsNav = window.matchMedia('(max-width: 900px)');
    const SIDEBAR_STATE_KEY = 'msp:sidebar-state';

    // Restore sidebar <details> open/closed state from sessionStorage
    const restoreSidebarState = () => {
      if (!docsNav) return;
      try {
        const saved = sessionStorage.getItem(SIDEBAR_STATE_KEY);
        if (!saved) return;
        const state = JSON.parse(saved);
        detailsMap = state;
        docsNav.querySelectorAll('details').forEach((d) => {
          const key = summaryKey(d);
          if (key && state[key] === false) d.open = false;
        });
      } catch {}
    };

    let detailsMap = {};
    const summaryKey = (details) => {
      const summary = details.querySelector(':scope > summary');
      return summary ? summary.textContent.trim() : null;
    };

    const saveSidebarState = () => {
      if (!docsNav) return;
      try {
        docsNav.querySelectorAll('details').forEach((d) => {
          const key = summaryKey(d);
          if (key) detailsMap[key] = d.open;
        });
        sessionStorage.setItem(SIDEBAR_STATE_KEY, JSON.stringify(detailsMap));
      } catch {}
    };

    if (docsShell && docsNav && docsNavToggles.length) {
      const syncTopbarHeight = () => {
        const topbarHeight = Math.ceil(topbar?.getBoundingClientRect().height || 0);
        if (topbarHeight) docsShell.style.setProperty('--nav-height', `${topbarHeight}px`);
      };

      const syncDocsNav = (open) => {
        docsShell.dataset.sidebarOpen = open ? 'true' : 'false';
        docsNav.setAttribute('aria-hidden', String(!open));
        docsNavToggles.forEach((button) => button.setAttribute('aria-expanded', String(open)));
        const overlayOpen = mobileDocsNav.matches && open;
        if (docsNavClose instanceof HTMLButtonElement) {
          docsNavClose.hidden = !overlayOpen;
          docsNavClose.disabled = !overlayOpen;
          docsNavClose.setAttribute('aria-hidden', String(!overlayOpen));
        }
      };

      const setResponsiveDefault = () => {
        syncTopbarHeight();
        syncDocsNav(!mobileDocsNav.matches);
      };
      const toggleDocsNav = () => syncDocsNav(docsShell.dataset.sidebarOpen !== 'true');

      // Restore expanded state from previous navigation
      restoreSidebarState();

      // Save state whenever a details toggle happens
      docsNav.addEventListener('toggle', saveSidebarState);

      docsNavToggles.forEach((button) => button.addEventListener('click', toggleDocsNav));
      docsNavClose?.addEventListener('click', () => syncDocsNav(false));
      docsNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        if (mobileDocsNav.matches) syncDocsNav(false);
      }));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && docsShell.dataset.sidebarOpen === 'true') syncDocsNav(false);
      });
      window.addEventListener('resize', syncTopbarHeight);

      setResponsiveDefault();
      docsShell.dataset.navReady = 'true';
      if ('addEventListener' in mobileDocsNav) mobileDocsNav.addEventListener('change', setResponsiveDefault);
      else mobileDocsNav.onchange = setResponsiveDefault;
    }
  </script>
</BaseLayout>
